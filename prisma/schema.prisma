generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SignalCategory {
  tweet
  video
  wechat
  podcast
  insight
  trend
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Signal {
  id             String         @id @default(cuid())
  category       SignalCategory
  author         String
  handle         String
  avatarInitials String
  role           String
  publishedAt    DateTime
  contentZh      String         @db.Text
  contentEn      String         @db.Text
  tags           String[]       @default([])
  likes          Int            @default(0)
  reposts        Int            @default(0)
  views          Int            @default(0)
  repostedFrom   String?
  sourceUrl      String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([category, publishedAt])
  @@index([publishedAt])
}

model Hotword {
  id        String   @id @default(cuid())
  word      String
  count     Int
  delta     String
  week      String
  createdAt DateTime @default(now())

  @@index([week])
}

model TrendPrediction {
  id        String   @id @default(cuid())
  content   String   @db.Text
  week      String
  createdAt DateTime @default(now())

  @@index([week])
}
